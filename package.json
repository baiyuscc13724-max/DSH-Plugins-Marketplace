{
  "name": "dsh-plugin-marketplace",
  "version": "0.1.0",
  "description": "DSH插件市场：从 GitHub topic dsh-plugin 浏览并安装插件",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bradeGithub/DSH-Plugins-Marketplace.git"
  },
  "license": "MIT"
}